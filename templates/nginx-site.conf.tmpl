# Rendered by install.sh - do not edit by hand.
# HTTP: ACME HTTP-01 challenges + redirect to HTTPS.

server {
    listen 80;
    listen [::]:80;
    server_name @@HOSTNAME@@ @@DOMAIN@@ mta-sts.@@DOMAIN@@;

    root /var/www/certbot;

    location /.well-known/acme-challenge/ {
        try_files $uri =404;
    }
    location = /admin { return 301 https://$host/admin/; }
    location /admin/  { return 301 https://$host$request_uri; }
    location /        { return 301 https://$host$request_uri; }
}

# HTTPS: mail hostname, apex domain and MTA-STS host share one certificate.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @@HOSTNAME@@ @@DOMAIN@@ mta-sts.@@DOMAIN@@;

    ssl_certificate     @@CERT_DIR@@/fullchain.pem;
    ssl_certificate_key @@CERT_DIR@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=15552000" always;

    include /etc/nginx/snippets/mailstack-locations.conf;
}
